# Public URL of the app (used for Stripe redirects and fal.ai webhooks). Locally: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — Project settings › API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# fal.ai — https://fal.ai/dashboard/keys (all image, video, voice and assembly jobs)
FAL_KEY=

# Anthropic — https://console.anthropic.com (writes the ad scripts and shot lists)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Stripe — prefer a restricted key (rk_…) with: Checkout Sessions (write), Customers (write),
# Customer portal (write), Prices (read), Products (read), Subscriptions (read), Invoices (read).
# Mark it "Sensitive" in Vercel. npm run stripe:setup needs a key with Products/Prices/Portal write.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_CURRENCY=eur
# Set to true only once a VAT registration is active in Stripe Tax (Dashboard › Tax › Registrations).
STRIPE_AUTOMATIC_TAX=false

# Any long random string (signs fal.ai webhook URLs)
WEBHOOK_SECRET=
